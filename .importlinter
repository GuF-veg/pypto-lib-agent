[importlinter]
root_packages =
    profile_db

[importlinter:contract:1]
name = pfdb-foundation-layering
type = layers
layers =
    profile_db.__main__
    profile_db.cli
    profile_db.mcp_server
    profile_db.api
    profile_db.query
    profile_db.ingest
    profile_db.lifecycle
    profile_db.derived
    profile_db.db
    profile_db.facts
    profile_db.render
    profile_db.schema
    profile_db.errors